# Copie para .env (cp .env.example .env) e ajuste os valores.

# --- Postgres ---
POSTGRES_USER=drivo
POSTGRES_PASSWORD=drivo
POSTGRES_DB=drivo

# --- Backend ---
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Chave gratuita em https://aistudio.google.com/apikey (necessária para importar CRLV)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend (embutida no build; é a URL da API vista pelo navegador) ---
NEXT_PUBLIC_API_URL=http://localhost:3333
